{
  "name": "frame-puzzle",
  "private": true,
  "version": "0.1.0",
  "description": "A calm jigsaw puzzle web app for young children on iPad. Finish a picture, earn stars, trade them for real gifts.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
